{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user-specific data and preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address."
        },
        "displayName": {
          "type": "string",
          "description": "User's display name."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL to user's profile picture."
        },
        "favorites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of tool IDs favorited by the user."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "User's role in the application."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user profile was created."
        }
      },
      "required": ["uid", "email", "favorites", "role", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection."
    }
  }
}
